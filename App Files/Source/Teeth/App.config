<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <!--
    NOTE: When you restore the NuGet packages in Visual Studio, it will very
    likely regenerate/append <runtime><assemblyBinding> redirect entries here
    automatically (for System.Data.SQLite and ClosedXML's dependencies, e.g.
    DocumentFormat.OpenXml / Irony / ExcelNumberFormat). That is expected and
    safe to keep - just let Visual Studio manage that section after restore.
  -->
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
    </assemblyBinding>
  </runtime>
</configuration>
